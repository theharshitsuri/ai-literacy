# Compass — env vars
# Copy to .env.local and fill in real values.

# ─── Public base URL ───────────────────────────────────────────
# Used by sitemap, robots, and OG image. Locally http://localhost:3000;
# on Vercel set to your real domain (compass.vercel.app or custom).
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ─── Neon (Postgres) ───────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
# Use the "pooled" connection string for serverless / edge.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# ─── Clerk (auth) ──────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Where to send users after sign-in / sign-up. Defaults below match our routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/feed
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/quiz

# ─── OpenAI — per-user caption generation ──────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# ─── Admin allowlist ───────────────────────────────────────────
# Comma-separated list of email addresses with /admin access.
ADMIN_EMAILS=suri.harshit@gmail.com

# ─── Cron secret ───────────────────────────────────────────────
# Random string. Vercel sends this as Authorization: Bearer <secret>
# on cron invocations. Generate with `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-string

# ─── Resend — email (skip for v1) ──────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Compass <hello@compass.example.com>

# ─── Stripe — premium subscription (skip for v1) ───────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...
